<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lic_title"
            android:textColor="#0F766E"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#0F172A"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/lic_device_label"
            android:textColor="#475569"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#0F172A"
            android:textDirection="ltr"
            android:textIsSelectable="true"
            android:textSize="26sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btn_copy"
            android:background="@drawable/bg_btn_soft"
            android:textColor="#0F766E"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/lic_copy" />

        <Button
            android:id="@+id/btn_wa"
            android:background="@drawable/bg_btn_soft"
            android:textColor="#0F766E"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lic_wa" />

        <Button
            android:id="@+id/btn_paste"
            android:background="@drawable/bg_btn_soft"
            android:textColor="#0F766E"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/lic_paste" />

        <EditText
            android:id="@+id/et_code"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:hint="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="40"
            android:singleLine="true"
            android:textDirection="ltr"
            android:textSize="17sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btn_activate"
            android:background="@drawable/bg_btn"
            android:textColor="#FFFFFF"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lic_activate" />

        <TextView
            android:id="@+id/tv_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:textColor="#B91C1C"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lic_back" />
    </LinearLayout>
</ScrollView>
